{
  "name": "weskills",
  "version": "0.1.0",
  "description": "Self-hosted Skills and Agent standards for teams",
  "keywords": [
    "agent-skills",
    "skills",
    "claude-code",
    "ai-agents",
    "registry",
    "self-hosted",
    "cloudflare-workers",
    "cloudflare-d1",
    "cloudflare-r2",
    "hono"
  ],
  "license": "MIT",
  "author": "Qsnh",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "dev": "npm run build && npm start",
    "build": "npx @tailwindcss/cli -i src/app.css -o public/app.css --minify && esbuild server/main.mjs --bundle --platform=node --target=node24 --format=cjs --outfile=dist/server.cjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "reset-password": "node scripts/reset-password.mjs",
    "typecheck": "tsc --noEmit",
    "verify:cli": "node scripts/verify-cli.mjs",
    "logo": "node scripts/export-logo.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "fixtures": "./scripts/make-fixtures.sh",
    "dev:worker": "concurrently \"npx @tailwindcss/cli -i src/app.css -o public/app.css --watch\" \"wrangler dev\"",
    "start": "node --env-file-if-exists=.env dist/server.cjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.9",
    "diff": "^9.0.0",
    "fflate": "^0.8.3",
    "hono": "^4.13.8",
    "marked": "^18.0.13",
    "parse5": "^8.1.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260922.1",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^26.6.2",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.136.1"
  },
  "bin": {
    "weskills": "cli/weskills.mjs"
  },
  "files": [
    "cli/",
    "README.md",
    "LICENSE"
  ]
}
